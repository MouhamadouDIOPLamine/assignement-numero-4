# =====================================================================
# Copiez ce fichier en ".env" dans le dossier client/ si besoin.
# En LOCAL, laissez vide : le proxy Vite (vite.config.js) redirige /api
# vers http://localhost:4000, donc aucune variable n'est necessaire.
#
# En PRODUCTION (Vercel), definissez cette variable sur l'URL publique
# de votre backend Railway, par exemple :
#   VITE_API_URL=https://pulsefit-server.up.railway.app
# =====================================================================
VITE_API_URL=
