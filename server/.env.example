# =====================================================================
# Copiez ce fichier en ".env" (dans le dossier server/) et remplissez-le.
# Le vrai fichier .env ne doit JAMAIS etre commite (voir .gitignore).
# =====================================================================

# URL de connexion Postgres fournie par Neon (onglet "Connection string").
# Gardez bien le "?sslmode=require" a la fin.
#DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Secret utilise pour signer les cookies de session.
# Mettez une longue chaine aleatoire (ex: sortie de `openssl rand -hex 32`).
#SESSION_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Origine autorisee a appeler l'API (le front). En local = Vite.
# En production, mettez l'URL Vercel, ex: https://pulsefit.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Port d'ecoute du serveur (Railway fournit son propre PORT automatiquement).
PORT=4000

# Laisser "development" en local, "production" une fois deploye.
NODE_ENV=development

# =====================================================================
# SEMAINE 4 - STRIPE (mode TEST)
# =====================================================================

# Cle secrete Stripe en mode TEST (Dashboard Stripe > Developers > API keys).
# Elle commence par "sk_test_...". Ne JAMAIS la committer.


# Secret de signature du webhook. En LOCAL, il est affiche par la commande
# `stripe listen --forward-to localhost:4000/api/webhook` (commence par whsec_).
# En PROD, il est donne quand vous creez le endpoint dans le Dashboard Stripe.


